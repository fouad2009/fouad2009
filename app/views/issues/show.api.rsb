api.issue do
    api.id @issue.id
    api.dot_name @issue.project&.name || "Unknown project"
    api.action_name @issue.tracker&.name || "Unknown tracker"
    api.status_name @issue.status&.name || "Unknown status"

    # Check if the issue is linked to a city and APS
    if @issue.parent&.parent
      api.zone_code @issue.parent.parent.custom_field_value(280).to_s.encode("UTF-8", invalid: :replace, undef: :replace, replace: "?")
      api.aps_gps_latitude @issue.parent.parent.custom_field_value(226)  || "Undefined"
      api.aps_gps_longitude @issue.parent.parent.custom_field_value(227) || "Undefined"
     else
      api.zone_code "Action not linked to a city or APS"
    end

    api.city_code @issue.parent&.custom_field_value(271) || "Undefined"
    api.priority_name @issue.priority&.name || "Unknown priority"
    api.author_name @issue.author&.name || "Unknown author"
    api.parent_id @issue.parent_id unless @issue.parent.nil?
    api.parent_subject @issue.parent&.subject || "No parent"
    api.subject @issue.subject || "Unknown subject"
    api.deadline @issue.custom_field_value(14) || "Undefined"
    api.start_date @issue.start_date || "Not specified"
    api.due_date @issue.due_date || "Not specified"
    api.progress_percentage @issue.done_ratio || 0
    api.amount_committed @issue.estimated_hours || 0
    api.ref_ods @issue.custom_field_value(18) || "Undefined"
    # Keep ods_file as basic "attachment/id"
    if @issue.custom_field_value(192).present?
      attachment_id = @issue.custom_field_value(192).to_i
      api.ods_file "attachment/#{attachment_id}"
    else
      api.ods_file "Undefined"
    end
    api.contractor_code @issue.custom_field_value(19) || "Undefined"
    # Handle specific tracker types
    case @issue.tracker_id
    when 60
      api.planned_capacity @issue.custom_field_value(24) || "Undefined"
      api.engaged_pbu_count @issue.custom_field_value(262) || "Undefined"
      api.realized_capacity @issue.custom_field_value(28) || "Undefined"
    when 4
      api.dist_linear_planned @issue.custom_field_value(217) 
      api.dist_linear_realized @issue.custom_field_value(218)
      api.alveolus_planned @issue.custom_field_value(74)
      api.alveolus_realized @issue.custom_field_value(27)


    else
      api.ERROR "No specific data for this issue type."
    end
  end



