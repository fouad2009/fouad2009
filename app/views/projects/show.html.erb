     <table class="actif">
        <%= display_process_actif(@process_data_report,[7,8,9,10,32,42],@project) %>
     </table>
   </div>
</div>

<div id="tab4" class="tab-content">

  <h4>Realisation Batiment</h4>
     <div class="etat-realisations">
       <% tracker_ids = @trackers.reject { |tracker| [4,7,6,8,9,10,29,27,30,32,33,47,42,52,53,54,58,59,61,62].include?(tracker.id) }.map(&:id) %>
          <table class="batiment">
            <%= display_process_data(@process_data_report,tracker_ids,@project) %>
          </table>
     </div>

</div>
