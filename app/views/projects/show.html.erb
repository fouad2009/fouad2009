<div class="tab-container">
  <div class="tab active" onclick="changeTab(event, 'tab1')">Acces filair</div>
  <div class="tab" onclick="changeTab(event, 'tab2')">FTTH par DOT</div>
  <div class="tab" onclick="changeTab(event, 'tab3')">Equipement Actif</div>
  <div class="tab" onclick="changeTab(event, 'tab6')">Liaisons FO</div>
  <div class="tab" onclick="changeTab(event, 'tab4')">Batiment</div>
  <div class="tab" onclick="changeTab(event, 'tab5')">Corporate DOT</div>
  
